{
  "name": "corporate-mailer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Microservicio de envio de correo (unico contenedor del proyecto con salida a internet).",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nodemailer": "9.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/nodemailer": "7.0.12",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  }
}
