# Plantilla de corporate-api/.env.test (gitignored, no versionado -ver
# TESTING.md para el detalle completo del setup). Copiar este archivo a
# ".env.test" y completar los valores reales.
#
# Apunta al stack de Testing (corporate-infra/compose.test.yml, "run.ps1 bdd
# test") -un servidor de BD COMPLETAMENTE separado de Development/Production,
# no una base con otro nombre dentro del mismo servidor de dev-. Los mismos
# init scripts que crean corpdbpg/corpdbsql/corpdbmng + sus usuarios de
# aplicacion en Development corren igual en Testing al levantar ese stack, asi
# que no hace falta ningun CREATE DATABASE/GRANT manual.

NODE_ENV=test
SUFFIX=test
PORT=3000
CORS_ORIGIN=*

# Valores de host/puerto/usuario: copiar de corporate-secrets/Testing/.env y
# corporate-secrets/Environment/.env (ALLOCATED_IP, POSTGRE_PORT, MSSQL_PORT,
# MONGO_PORT, REDIS_PORT, PG_APP_USER+SUFFIX, MSSQL_APP_USER+SUFFIX,
# MONGO_USER+SUFFIX -en Testing, SUFFIX=test-).
POSTGRES_HOST=<ALLOCATED_IP>
POSTGRES_INTERNAL_PORT=<POSTGRE_PORT>
POSTGRES_DATABASE=corpdbpg
PG_APP_USER=<PG_APP_USER>test
PG_APP_USER_PASSWORD_FILE=../corporate-secrets/Testing/pg_user_password.txt

MSSQL_HOST=<ALLOCATED_IP>
MSSQL_INTERNAL_PORT=<MSSQL_PORT>
MSSQL_DBNAME=corpdbsql
MSSQL_APP_USER=<MSSQL_APP_USER>test
MSSQL_APP_USER_PASSWORD_FILE=../corporate-secrets/Testing/mssql_app_password.txt
# tedious tiene un bug conocido conectando via IP literal (ver el comentario
# en src/library/env.ts, campo mssql.encrypt): MSSQL_HOST de arriba es un IP,
# no un hostname de contenedor como en Development/Testing/Production reales.
MSSQL_ENCRYPT=false

REDIS_HOST=<ALLOCATED_IP>
REDIS_INTERNAL_PORT=<REDIS_PORT>
REDIS_PASSWORD_FILE=../corporate-secrets/Testing/redis_password.txt
# Indice de Redis dedicado a tests dentro de la MISMA instancia de Testing:
# nunca 0 (ese es el que usaria corporate-api si alguna vez se levanta
# "run.ps1 backend test" en paralelo). flushDb() en los tests solo toca este
# indice.
REDIS_DB=1

MONGO_HOST=<ALLOCATED_IP>
MONGO_INTERNAL_PORT=<MONGO_PORT>
MONGO_DATABASE=corpdbmng
MONGO_USER=<MONGO_USER>test
MONGO_USER_PASSWORD_FILE=../corporate-secrets/Testing/db_mongo_user_password.txt
# Desde el host solo el primario esta publicado (ver el comentario en
# src/library/env.ts, campo mongo.directConnection); sin esto el driver
# intenta descubrir el resto del replica set por hostname interno de Docker
# y se cuelga.
MONGO_DIRECT_CONNECTION=true

SESSION_NAME=sid.test
SESSION_TTL_HOURS=8
SESSION_SECRET_FILE=../corporate-secrets/Testing/session_secret.txt

JWT_ACCESS_TTL=43200
JWT_REFRESH_TTL=604800
JWT_ACCESS_SECRET_FILE=../corporate-secrets/Testing/jwt_access_secret.txt
JWT_REFRESH_SECRET_FILE=../corporate-secrets/Testing/jwt_refresh_secret.txt

ADMIN_BOOTSTRAP_PASSWORD_FILE=../corporate-secrets/Testing/bootstrap_admin_password.txt
DEFAULT_USER_PASSWORD_FILE=../corporate-secrets/Testing/default_user_password.txt

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_LIMIT=5

# Nunca en true aca: env.ts aborta el arranque si alguno esta en true con
# NODE_ENV != "development" (failing closed, ver el comentario en env.ts).
DISABLE_AUTH=false
DISABLE_PERMISSIONS=false
DISABLE_VALIDATION=false

MAX_POOL=10
MIN_POOL=2

# Sin mailer real en tests: sendMailViaMailer ya es best-effort (ver env.ts),
# con MAILER_URL vacio devuelve {ok:false} en vez de intentar una request real.
MAILER_URL=
